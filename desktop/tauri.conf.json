{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grid Hedge Bot",
  "mainBinaryName": "grid-hedge-bot",
  "version": "0.1.3",
  "identifier": "com.gridhedgebot.desktop",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Grid Hedge Bot",
        "width": 1420,
        "height": 930,
        "minWidth": 880,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "backgroundColor": "#080D19",
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Finance",
    "shortDescription": "Bybit Grid Hedge Bot",
    "longDescription": "Grid Hedge Bot with a supervised embedded backend, separate DEMO/LIVE environments and local protected account credentials.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "externalBin": ["binaries/gridbot-backend"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": false,
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist",
      "dmg": {
        "background": "assets/dmg-background.png",
        "windowSize": {"width": 660, "height": 420},
        "appPosition": {"x": 180, "y": 205},
        "applicationFolderPosition": {"x": 480, "y": 205}
      }
    }
  }
}
